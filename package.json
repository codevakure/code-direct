{
  "name": "code-direct",
  "displayName": "VS Code Editor Metrics",
  "description": "Track VS Code metrics",
  "version": "0.0.1",
  "publisher": "codevakure",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codevakure/code-direct.git"
  },
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
     "onCommand:code-direct.generateReport"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-direct.generateReport",
        "title": "Generate VS Code Usage Report"
      }
    ],
    "configuration": {
      "title": "Copilot Metrics",
      "properties": {
        "copilotMetrics.teamsWebhookUrl": {
          "type": "string",
          "default": "",
          "description": "Microsoft Teams webhook URL for sending reports"
        }
      }
    }
  },
  "dependencies": {
    "axios": "^1.6.2",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  }
}
